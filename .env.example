# OrsuSpace Mission Operations Lab — Environment Configuration
# Copy to .env and fill in all values before running ./deploy.sh start

# ---- Domain and Networking ----
DOMAIN=orsuspace.online
VPS_IP=your.vps.ip.here

# ---- SSL Certificate (Let's Encrypt) ----
# Must be a valid email — Let's Encrypt sends expiry notices here
SSL_EMAIL=admin@orsuspace.online

# ---- PostgreSQL ----
DB_NAME=spaceve1
DB_USER=spaceops
DB_PASSWORD=change_this_strong_password_2024

# ---- Initial Operator Account ----
# Created on first deploy. Change the password after first login.
OPERATOR_USER=admin
OPERATOR_PASSWORD=change_this_in_production

# ---- Ground Station Credentials ----
# GS-ALPHA is authenticated. GS-BETA is maintenance mode (intentional misconfiguration).
GS_ALPHA_TOKEN=gs_alpha_2024

# ---- Internal Docker Network ----
# All containers share this network in production
DOCKER_SUBNET=172.20.0.0/24
MOC_IP=172.20.0.10
GS1_IP=172.20.0.20
GS2_IP=172.20.0.21
SAT_A_IP=172.20.0.100
SAT_B_IP=172.20.0.101
SAT_C_IP=172.20.0.102
DB_IP=172.20.0.200

# ---- Satellite Parameters ----
TIME_WARP=60

# ---- Ports (host-exposed) ----
# MOC dashboard is exposed via nginx HTTPS, not directly
GS_BETA_PORT=4820
GRAFANA_PORT=3000
