# SpaceVE-1 Lab Environment Variables
#
# The lab runs from the lab/ directory. Copy the example there and start:
#   cd lab
#   cp .env.example .env
#   ./deploy.sh start
#
# This root copy is kept only for reference. docker-compose.yml reads just
# the two variables below.

# Database password (default works for the lab, change for any real deployment)
DB_PASSWORD=spaceops2024

# NASA Earth Imagery API (free key: https://api.nasa.gov/)
# Optional. Required only for Objective 5 (capture real Landsat imagery).
# Leave as-is to use simulated imagery instead.
NASA_API_KEY=your_nasa_api_key_here
NASA_API_URL=https://api.nasa.gov/planetary/earth/imagery
